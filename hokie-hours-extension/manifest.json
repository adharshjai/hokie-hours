{
  "manifest_version": 3,
  "name": "Hokie Hours",
  "version": "1.1.0",
  "description": "Unofficial live countdown of hours left under your weekly limit (20 by default) on the Banner Employee Self-Service timesheet.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://selfservice.banner.vt.edu/EmployeeSelfService/*"],
      "js": ["hours.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
